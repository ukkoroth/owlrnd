    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "ai:smoke": "tsx --conditions=react-server scripts/ai-smoke.ts",
    "access": "tsx --conditions=react-server scripts/access.ts",
    "invite": "tsx --conditions=react-server scripts/access.ts invite"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@node-rs/argon2": "^2.2.2",
    "drizzle-orm": "^0.45.4",
    "next": "^15.5.29",
    "nodemailer": "^10.5.0",
    "pg": "^8.23.1",
    "postmark": "^5.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.2",
    "dotenv": "^18.0.10",
