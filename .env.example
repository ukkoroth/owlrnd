# Postgres (docker compose maps it to 5433)
DATABASE_URL=postgres://owlrnd:owlrnd@localhost:5433/owlrnd

# Email: "smtp" sends to Mailpit in dev (inbox at http://localhost:8025),
# "postmark" sends real email, "console" just prints codes to the server log.
EMAIL_TRANSPORT=smtp
SMTP_URL=smtp://localhost:1025
POSTMARK_SERVER_TOKEN=
EMAIL_FROM="owlrnd <codes@example.com>"

# Anthropic (needed from M3). The SDK also picks up an `ant auth login` profile.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Where uploaded files are stored locally
STORAGE_DIR=./storage

# Signs pending sign-in steps and keys code hashes. 32+ random characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Public address of the app, used in invitation links (no trailing slash)
APP_URL=http://localhost:3000

# Closed beta: new "Get access" requests are emailed here (optional)
OWNER_EMAIL=
